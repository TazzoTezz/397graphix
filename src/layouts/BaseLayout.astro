---
import '../styles/global.css';
import { SITE, NAV_LINKS, SERVICES } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  currentPage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = '',
  currentPage = '/',
  noindex = false,
} = Astro.props;

const canonicalUrl = `${SITE.domain}/${canonicalPath.replace(/^\//, '')}`;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.name,
  url: `${SITE.domain}/`,
  telephone: '+64 22 500 3904',
  email: SITE.email,
  image: `${SITE.domain}/assets/img/og.jpg`,
  logo: `${SITE.domain}/assets/img/logo.png`,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Wellington',
    addressRegion: 'Wellington',
    addressCountry: 'NZ',
  },
  areaServed: [
    'Wellington',
    'Lower Hutt',
    'Upper Hutt',
    'Porirua',
    'Kapiti Coast',
  ],
};
---

<!doctype html>
<html lang="en-NZ" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/assets/img/favicon.png" />
    <meta name="theme-color" content="#08090C" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${SITE.domain}/assets/img/og.jpg`} />

    <!-- Self-hosted Variable Font -->
    <link
      rel="preload"
      href="/assets/fonts/archivo-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="min-h-screen flex flex-col bg-obsidian text-gray-300">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:bg-volt focus:px-4 focus:py-2.5 focus:text-sm focus:font-black focus:uppercase focus:text-obsidian"
    >
      Skip to main content
    </a>

    <!-- Top Technical Spec Micro-Bar -->
    <div class="hidden md:block border-b border-white/[0.08] bg-[#0B0D12] text-xs font-mono uppercase tracking-[0.14em] text-gray-400">
      <div class="container-wrap flex h-9 items-center justify-between">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-2 text-volt font-bold">
            <span class="h-1.5 w-1.5 rounded-full bg-volt inline-block"></span>
            WELLINGTON REGION, NZ
          </span>
          <span class="text-white/20">|</span>
          <span>DESIGN · FABRICATION · INSTALLATION</span>
        </div>
        <div class="flex items-center gap-6">
          <a href={`mailto:${SITE.email}`} class="text-gray-300 hover:text-volt transition-colors">
            {SITE.email}
          </a>
        </div>
      </div>
    </div>

    <!-- Main Navigation Header -->
    <header
      id="site-header"
      class="sticky top-0 z-50 border-b border-white/[0.1] bg-obsidian/95 backdrop-blur-xl"
    >
      <div class="container-wrap flex h-20 items-center justify-between gap-4">
        <a
          href="/"
          class="group flex items-center gap-3.5 shrink-0 focus:outline-none"
          aria-label="397 Graphix — Home"
        >
          <img
            src="/assets/img/logo.png"
            alt="397 Graphix"
            width="523"
            height="251"
            class="h-10 w-auto sm:h-11 transition-transform duration-300 group-hover:scale-105"
          />
          <div class="hidden sm:flex items-center gap-1.5 h-7" aria-hidden="true">
            <span class="block w-1.5 h-full bg-white/80 -skew-x-[24deg] transition-colors group-hover:bg-volt"></span>
            <span class="block w-0.5 h-full bg-white/30 -skew-x-[24deg]"></span>
          </div>
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
          {
            NAV_LINKS.map((link) => {
              const isActive = currentPage === link.match;
              return (
                <a
                  href={link.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'relative rounded px-3.5 py-2 text-xs font-mono uppercase tracking-[0.12em] whitespace-nowrap transition-colors duration-150',
                    isActive
                      ? 'bg-white/[0.08] text-volt font-bold'
                      : 'text-gray-300 hover:bg-white/[0.04] hover:text-white',
                  ]}
                >
                  {link.label}
                </a>
              );
            })
          }
        </nav>

        <!-- Desktop Actions -->
        <div class="hidden lg:flex items-center gap-3 shrink-0">
          <a
            href={SITE.tel}
            class="inline-flex items-center gap-2 rounded border border-[#363E4F] bg-[#1A1E29] px-4 py-2.5 text-xs font-mono font-bold uppercase tracking-wider text-white whitespace-nowrap transition-all hover:border-volt hover:text-volt"
          >
            <svg class="h-3.5 w-3.5 text-volt shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="whitespace-nowrap">{SITE.phone}</span>
          </a>
          <a href="/contact#quote" class="btn-primary !py-2.5 !px-5 !text-xs">
            <span>Get a Quote</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <div class="flex items-center gap-2 lg:hidden">
          <a
            href={SITE.tel}
            class="inline-flex items-center gap-1.5 rounded border border-volt/50 bg-volt/10 px-3 py-2 text-xs font-mono font-bold uppercase text-volt whitespace-nowrap"
            aria-label={`Call ${SITE.phone}`}
          >
            <span>Call {SITE.phone}</span>
          </a>
          <button
            id="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label="Toggle navigation menu"
            class="inline-flex h-10 w-10 items-center justify-center rounded border border-[#363E4F] bg-[#1A1E29] text-white transition-colors hover:border-volt hover:text-volt"
          >
            <svg id="icon-menu" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div
        id="mobile-nav"
        hidden
        class="border-t border-white/[0.1] bg-[#11131A] lg:hidden"
      >
        <div class="container-wrap py-6 space-y-5">
          <nav class="flex flex-col divide-y divide-white/[0.08]" aria-label="Mobile navigation">
            {
              NAV_LINKS.map((link, i) => {
                const isActive = currentPage === link.match;
                return (
                  <a
                    href={link.href}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'flex items-center justify-between py-3.5 text-base font-heading font-bold uppercase tracking-wide transition-colors',
                      isActive ? 'text-volt' : 'text-white hover:text-volt',
                    ]}
                  >
                    <span>{link.label}</span>
                    <span class="text-xs font-mono text-gray-500">0{i + 1}</span>
                  </a>
                );
              })
            }
          </nav>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            <a href={SITE.tel} class="btn-secondary w-full justify-center">
              Call {SITE.phone}
            </a>
            <a href="/contact#quote" class="btn-primary w-full justify-center">
              Request a Quote
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Page Content -->
    <main id="main" class="flex-1">
      <slot />
    </main>

    <!-- High-Impact Industrial Footer -->
    <footer class="border-t border-white/[0.12] bg-[#0D0F14] relative overflow-hidden">
      <!-- Pre-footer Diagonal Livery CTA -->
      <div class="relative border-b border-white/[0.1] bg-obsidian overflow-hidden">
        <div class="livery-stripes pointer-events-none absolute inset-0 opacity-50"></div>
        <div class="container-wrap relative z-10 py-16 sm:py-20">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7">
              <span class="eyebrow-badge mb-4">READY WHEN YOU ARE // WELLINGTON</span>
              <h2 class="font-display text-3xl sm:text-5xl text-white">
                LET’S BUILD SOMETHING <span class="text-volt">SHARP.</span>
              </h2>
              <p class="mt-4 text-base text-gray-300 max-w-xl leading-relaxed">
                Skip the account managers. Talk straight to Ryan for a fast, no-nonsense quote on vehicle wraps, commercial fleet graphics, frosted glass, or illuminated signage.
              </p>
            </div>
            <div class="lg:col-span-5 flex flex-col sm:flex-row lg:justify-end gap-3.5">
              <a href={SITE.tel} class="btn-primary text-sm sm:text-base px-6 py-4">
                <span>Call {SITE.phone}</span>
              </a>
              <a href="/contact#quote" class="btn-secondary text-sm sm:text-base px-6 py-4">
                <span>Request Quote Online</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Grid -->
      <div class="container-wrap py-16">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-12">
          <!-- Brand Col -->
          <div class="lg:col-span-4 space-y-4">
            <a href="/" class="inline-block">
              <img
                src="/assets/img/logo.png"
                alt="397 Graphix"
                width="523"
                height="251"
                loading="lazy"
                class="h-11 w-auto"
              />
            </a>
            <p class="text-sm text-gray-400 max-w-sm leading-relaxed">
              Full vehicle wraps, commercial fleet livery, architectural window frosting, 3D reception logos, and custom LED light fixtures. Designed, cut, and installed in Wellington.
            </p>
            <div class="inline-flex items-center gap-2.5 rounded border border-[#2C3342] bg-[#141720] px-3.5 py-2 text-xs font-mono text-gray-300">
              <span class="h-2 w-2 rounded-full bg-volt shrink-0"></span>
              <span>Wellington · Hutt Valley · Porirua · Kapiti</span>
            </div>
          </div>

          <!-- Navigation Col -->
          <div class="lg:col-span-2">
            <h3 class="text-xs font-mono font-bold uppercase tracking-[0.16em] text-volt mb-4">
              Navigation
            </h3>
            <ul class="space-y-2.5 text-sm font-medium">
              {
                NAV_LINKS.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-gray-300 transition-colors hover:text-volt"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Services Col -->
          <div class="lg:col-span-3">
            <h3 class="text-xs font-mono font-bold uppercase tracking-[0.16em] text-volt mb-4">
              Capabilities
            </h3>
            <ul class="space-y-2.5 text-sm font-medium">
              {
                SERVICES.map((s) => (
                  <li>
                    <a
                      href={`/services#${s.id}`}
                      class="text-gray-300 transition-colors hover:text-volt flex items-center gap-2"
                    >
                      <span class="text-xs font-mono text-gray-500">{s.number}</span>
                      <span>{s.name}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Direct Contact Col -->
          <div class="lg:col-span-3">
            <h3 class="text-xs font-mono font-bold uppercase tracking-[0.16em] text-volt mb-4">
              Direct Line
            </h3>
            <div class="space-y-4">
              <div>
                <span class="block text-xs font-mono uppercase text-gray-500 mb-0.5">Phone</span>
                <a
                  href={SITE.tel}
                  class="font-heading text-xl sm:text-2xl font-extrabold text-white hover:text-volt whitespace-nowrap transition-colors"
                >
                  {SITE.phone}
                </a>
              </div>
              <div>
                <span class="block text-xs font-mono uppercase text-gray-500 mb-0.5">Email</span>
                <a
                  href={`mailto:${SITE.email}`}
                  class="text-sm font-mono text-gray-300 hover:text-volt break-all transition-colors"
                >
                  {SITE.email}
                </a>
              </div>
              <div class="pt-3 flex flex-wrap gap-4 border-t border-white/[0.08] text-xs font-mono font-bold uppercase">
                <a href="/contact#quote" class="text-volt hover:underline whitespace-nowrap">
                  Request Quote &rarr;
                </a>
                <a href="/contact#pay" class="text-gray-300 hover:text-white whitespace-nowrap">
                  Pay Invoice
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-gray-500 pb-16 lg:pb-0">
          <p>&copy; <span id="year">{new Date().getFullYear()}</span> {SITE.name}. All rights reserved.</p>
          <p>Designed, Fabricated &amp; Installed in Wellington, New Zealand.</p>
        </div>
      </div>
    </footer>

    <!-- Mobile Sticky Quick-Action Dock -->
    <div
      id="mobile-dock"
      class="fixed inset-x-0 bottom-0 z-40 border-t border-[#2C3342] bg-[#0B0D12]/95 backdrop-blur-xl p-3 lg:hidden"
    >
      <div class="grid grid-cols-2 gap-2.5 max-w-md mx-auto">
        <a
          href={SITE.tel}
          class="btn-secondary !py-3 !px-3 !text-xs w-full"
        >
          <span class="h-2 w-2 rounded-full bg-volt shrink-0"></span>
          <span class="whitespace-nowrap">Call {SITE.phone}</span>
        </a>
        <a
          href="/contact#quote"
          class="btn-primary !py-3 !px-3 !text-xs w-full"
        >
          <span class="whitespace-nowrap">Get a Quote &rarr;</span>
        </a>
      </div>
    </div>

    <!-- Lightbox Modal -->
    <div
      id="lightbox"
      hidden
      role="dialog"
      aria-modal="true"
      aria-label="Project photo viewer"
      class="fixed inset-0 z-[100] flex items-center justify-center bg-obsidian/95 backdrop-blur-xl p-4 sm:p-10"
    >
      <button
        type="button"
        class="lb-close absolute top-4 right-4 sm:top-6 sm:right-6 z-10 inline-flex h-11 w-11 items-center justify-center rounded border border-[#363E4F] bg-[#1E2330] text-white transition-colors hover:border-volt hover:text-volt"
        aria-label="Close photo viewer"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <button
        type="button"
        class="lb-prev absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-10 inline-flex h-11 w-11 items-center justify-center rounded border border-[#363E4F] bg-[#1E2330] text-white transition-colors hover:border-volt hover:text-volt"
        aria-label="Previous photo"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <figure class="max-h-full max-w-5xl flex flex-col items-center justify-center m-0">
        <div class="relative overflow-hidden rounded border border-white/[0.15] bg-charcoal shadow-2xl">
          <img
            id="lb-img"
            src=""
            alt=""
            class="max-h-[75vh] w-auto object-contain"
          />
        </div>
        <figcaption class="mt-4 text-center max-w-2xl px-4">
          <span id="lb-tag" class="inline-block rounded bg-volt px-2.5 py-0.5 text-xs font-mono font-bold uppercase tracking-wider text-obsidian mb-1.5"></span>
          <p id="lb-cap" class="text-sm sm:text-base font-bold text-white m-0"></p>
          <p id="lb-count" class="text-xs font-mono text-gray-400 mt-1 m-0"></p>
        </figcaption>
      </figure>

      <button
        type="button"
        class="lb-next absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-10 inline-flex h-11 w-11 items-center justify-center rounded border border-[#363E4F] bg-[#1E2330] text-white transition-colors hover:border-volt hover:text-volt"
        aria-label="Next photo"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <script is:inline src="/script.js"></script>
  </body>
</html>
