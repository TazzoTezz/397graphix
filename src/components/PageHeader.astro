---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="relative overflow-hidden border-b border-white/[0.1] bg-charcoal py-16 sm:py-24">
  <div class="bg-grid-pattern pointer-events-none absolute inset-0 opacity-75"></div>
  <div class="livery-stripes pointer-events-none absolute inset-y-0 right-0 w-1/3 opacity-40"></div>

  <div class="container-wrap relative z-10">
    <div class="max-w-4xl">
      <span class="eyebrow-badge mb-5">{eyebrow}</span>
      <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl text-white">
        {title}
      </h1>
      <p class="mt-5 text-base sm:text-xl text-gray-300 leading-relaxed max-w-2xl">
        {description}
      </p>
      <slot />
    </div>
  </div>
</section>
