---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE, SERVICES } from '../data/site';
---

<BaseLayout
  title="Contact & Request a Quote | 397 Graphix Wellington"
  description="Call Ryan on 022 500 3904 or send a quote request online for vehicle wraps, signage, and office fit-outs in Wellington."
  canonicalPath="contact"
  currentPage="/contact"
>
  <PageHeader
    eyebrow="DIRECT LINE // QUOTES & BOOKINGS"
    title="LET’S LOCK IN YOUR JOB."
    description="Give Ryan a call for an immediate chat, or send through your job specs and photos below and we’ll come back to you with ideas and a sharp price."
  />

  <section class="py-16 sm:py-24 border-b border-white/[0.1]">
    <div class="container-wrap">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-start">
        <!-- Direct Contact Sidebar -->
        <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-28">
          <div class="material-card p-6 sm:p-7 space-y-6">
            <div>
              <span class="text-xs font-mono uppercase tracking-wider text-volt font-bold">
                Call Ryan Directly
              </span>
              <a
                href={SITE.tel}
                class="mt-1.5 block font-heading text-2xl sm:text-3xl font-extrabold text-white hover:text-volt whitespace-nowrap transition-colors"
              >
                {SITE.phone}
              </a>
              <p class="mt-1.5 text-xs font-mono text-gray-400">
                Mon–Fri · On-site measures across Wellington
              </p>
            </div>

            <div class="border-t border-white/[0.1] pt-5">
              <span class="text-xs font-mono uppercase tracking-wider text-gray-400">
                Email
              </span>
              <a
                href={`mailto:${SITE.email}`}
                class="mt-1 block text-base font-mono font-bold text-white hover:text-volt break-all"
              >
                {SITE.email}
              </a>
            </div>

            <div class="border-t border-white/[0.1] pt-5">
              <span class="text-xs font-mono uppercase tracking-wider text-gray-400">
                Coverage Area
              </span>
              <p class="mt-1 text-sm text-gray-300 leading-relaxed">
                Wellington CBD, Lower Hutt, Upper Hutt, Porirua &amp; Kapiti Coast
              </p>
            </div>
          </div>

          <div class="rounded-md border border-[#2C3342] bg-[#13161F] p-6 text-xs sm:text-sm text-gray-300 space-y-2.5">
            <p class="font-mono font-bold uppercase text-volt text-xs">
              + Fast-Track Your Quote:
            </p>
            <ul class="space-y-1.5 list-disc pl-4">
              <li><strong class="text-white">Vehicles:</strong> Make, model, year &amp; current colour</li>
              <li><strong class="text-white">Glass / Fit-outs:</strong> Rough width &times; height &amp; panel count</li>
              <li><strong class="text-white">Photos:</strong> Attach a quick phone photo of the site or vehicle</li>
            </ul>
          </div>
        </aside>

        <!-- Quote Request Form -->
        <div class="lg:col-span-8">
          <form
            id="quote"
            action="/api/quote"
            method="post"
            enctype="multipart/form-data"
            novalidate
            class="material-card p-6 sm:p-9 space-y-6 border-t-2 border-t-volt"
          >
            <div class="border-b border-white/[0.1] pb-5">
              <span class="font-mono text-xs text-volt font-bold uppercase">// Job Specification Sheet</span>
              <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-white mt-1">
                Request a Free Quote
              </h2>
              <p class="mt-1 text-sm text-gray-400">
                Fields marked with <span class="text-volt font-bold">*</span> are required.
              </p>
            </div>

            <!-- Attached Custom Vehicle Wrap Design Preview (populated from Studio Designer) -->
            <div
              id="quote-design-preview-card"
              hidden
              class="rounded-md border-2 border-volt bg-[#0A0C10] p-4 space-y-3"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-mono font-bold uppercase text-volt">
                  // ATTACHED CUSTOM VEHICLE WRAP DESIGN
                </span>
                <button
                  type="button"
                  id="quote-design-remove-btn"
                  class="text-xs font-mono font-bold uppercase text-gray-400 hover:text-white"
                >
                  Clear Design
                </button>
              </div>
              <div class="overflow-hidden rounded border border-white/10 bg-[#07080B]">
                <img
                  id="quote-design-preview-img"
                  src=""
                  alt="Your custom vehicle wrap design preview"
                  class="w-full h-auto object-contain max-h-56"
                />
              </div>
              <p id="quote-design-preview-summary" class="text-xs font-mono text-gray-300"></p>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="f-name" class="block text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-2">
                  Your Name *
                </label>
                <input
                  id="f-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  placeholder="e.g. Sam Taylor"
                  class="w-full rounded border border-[#363E4F] bg-[#0A0C10] px-4 py-3 text-sm text-white placeholder-gray-500 focus:border-volt focus:outline-none"
                />
              </div>

              <div>
                <label for="f-business" class="block text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-2">
                  Business Name
                </label>
                <input
                  id="f-business"
                  name="business"
                  type="text"
                  autocomplete="organization"
                  placeholder="Optional"
                  class="w-full rounded border border-[#363E4F] bg-[#0A0C10] px-4 py-3 text-sm text-white placeholder-gray-500 focus:border-volt focus:outline-none"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="f-phone" class="block text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-2">
                  Phone Number
                </label>
                <input
                  id="f-phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  placeholder="e.g. 021 123 4567"
                  class="w-full rounded border border-[#363E4F] bg-[#0A0C10] px-4 py-3 text-sm text-white placeholder-gray-500 focus:border-volt focus:outline-none"
                />
              </div>

              <div>
                <label for="f-email" class="block text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-2">
                  Email Address
                </label>
                <input
                  id="f-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="you@company.co.nz"
                  class="w-full rounded border border-[#363E4F] bg-[#0A0C10] px-4 py-3 text-sm text-white placeholder-gray-500 focus:border-volt focus:outline-none"
                />
              </div>
            </div>
            <p class="!mt-2 text-xs font-mono text-gray-400">
              Please provide either a phone number or an email address so we can reply.
            </p>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="f-service" class="block text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-2">
                  What Do You Need? *
                </label>
                <select
                  id="f-service"
                  name="service"
                  class="w-full rounded border border-[#363E4F] bg-[#0A0C10] px-4 py-3 text-sm text-white focus:border-volt focus:outline-none"
                >
                  {
                    SERVICES.map((s) => (
                      <option value={s.name} data-id={s.id}>
                        {s.name}
                      </option>
                    ))
                  }
                  <option value="Multiple services / Full package" data-id="package">
                    Multiple services / Full package
                  </option>
                  <option value="Not sure yet" data-id="unsure">
                    Not sure yet
                  </option>
                </select>
              </div>

              <div>
                <label for="f-when" class="block text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-2">
                  Ideal Timeframe
                </label>
                <select
                  id="f-when"
                  name="when"
                  class="w-full rounded border border-[#363E4F] bg-[#0A0C10] px-4 py-3 text-sm text-white focus:border-volt focus:outline-none"
                >
                  <option>No rush / Flexible</option>
                  <option>Within a month</option>
                  <option>Within two weeks</option>
                  <option>As soon as possible</option>
                </select>
              </div>
            </div>

            <div>
              <label for="f-location" class="block text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-2">
                Suburb or Job Location
              </label>
              <input
                id="f-location"
                name="location"
                type="text"
                placeholder="e.g. Petone, Wellington CBD, Porirua"
                class="w-full rounded border border-[#363E4F] bg-[#0A0C10] px-4 py-3 text-sm text-white placeholder-gray-500 focus:border-volt focus:outline-none"
              />
            </div>

            <div>
              <label for="f-message" class="block text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-2">
                Job Details *
              </label>
              <textarea
                id="f-message"
                name="message"
                rows="5"
                required
                placeholder="Vehicle make and model, sign dimensions, number of rooms/windows, or any ideas you have..."
                class="w-full rounded border border-[#363E4F] bg-[#0A0C10] px-4 py-3 text-sm text-white placeholder-gray-500 focus:border-volt focus:outline-none"
              ></textarea>
            </div>

            <div>
              <span class="block text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-2">
                Photos, Logo or Floor Plans (Optional)
              </span>
              <label
                for="f-photos"
                class="drop group relative flex flex-col items-center justify-center rounded border-2 border-dashed border-[#363E4F] bg-[#0A0C10] p-7 text-center cursor-pointer transition-colors hover:border-volt"
              >
                <input
                  id="f-photos"
                  name="photos"
                  type="file"
                  accept="image/jpeg,image/png,image/webp,image/heic,image/heif,application/pdf"
                  multiple
                  class="sr-only"
                />
                <span class="drop-text text-sm font-mono font-bold uppercase text-white group-hover:text-volt">
                  + Choose Files or Drag Them Here
                </span>
                <span class="drop-sub mt-1.5 text-xs text-gray-400">
                  Up to 5 files (JPG, PNG, WebP, HEIC or PDF, 20 MB total).
                </span>
              </label>
            </div>

            <div class="sr-only" aria-hidden="true">
              <label for="f-website">Leave this empty</label>
              <input
                id="f-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="turnstile" data-sitekey={SITE.turnstileSiteKey}></div>

            <div class="pt-2">
              <button type="submit" class="btn-primary w-full py-4 text-base">
                <span>Send Quote Request</span>
                <span aria-hidden="true">&rarr;</span>
              </button>
              <p
                class="form-note mt-3 text-sm font-mono text-rose-300 min-h-[1.5rem]"
                role="status"
                aria-live="polite"
              ></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Invoice Payment Section -->
  <section id="pay" class="py-16 bg-[#0D0F14] scroll-mt-24">
    <div class="container-wrap">
      <div class="material-card p-6 sm:p-9 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-xl">
          <span class="eyebrow-badge mb-3">ACCOUNTS // BILLING</span>
          <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-white">
            Pay an Invoice
          </h2>
          <p class="mt-2 text-sm sm:text-base text-gray-300 leading-relaxed">
            You can pay by direct bank transfer using the account details on your invoice<span data-needs-link-text>, or pay online by card</span>. Please include your invoice number as the payment reference.
          </p>
        </div>

        <div class="shrink-0 space-y-2">
          <a
            href={SITE.stripeLink}
            data-needs-link
            target="_blank"
            rel="noopener"
            class="btn-primary w-full sm:w-auto"
          >
            Pay Online by Card
          </a>
          <p class="text-xs font-mono text-gray-400">
            Questions? Call <a href={SITE.tel} class="text-volt underline whitespace-nowrap">{SITE.phone}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
