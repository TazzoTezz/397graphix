---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Page Not Found | 397 Graphix"
  description="Page not found."
  canonicalPath="404"
  noindex={true}
>
  <section class="py-24 sm:py-32">
    <div class="container-wrap text-center max-w-xl mx-auto">
      <span class="eyebrow-badge mb-4">Error 404</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        This page has peeled off.
      </h1>
      <p class="mt-4 text-base text-gray-400 leading-relaxed">
        The page you are looking for doesn’t exist or has moved to a new address.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
        <a href="/" class="btn-primary">
          Back to Home
        </a>
        <a href={SITE.tel} class="btn-secondary">
          Call {SITE.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

